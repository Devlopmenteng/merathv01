{
  "name": "merath",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-naskh-arabic": "^0.4.5",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "^11.5.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.17.5",
    "@react-navigation/stack": "^7.2.0",
    "expo": "~55.0.26",
    "expo-constants": "~55.0.16",
    "expo-file-system": "~55.0.22",
    "expo-font": "~55.0.8",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-localization": "~55.0.15",
    "expo-mail-composer": "~55.0.14",
    "expo-print": "~55.0.15",
    "expo-sharing": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-store-review": "~55.0.14",
    "i18n-js": "^4.5.3",
    "i18next": "^25.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-pager-view": "^8.0.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-view-shot": "^4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "react-native-xml2js": "^1.0.3",
    "react-native-zip-archive": "^7.0.0",
    "react-test-renderer": "19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "vitest": "^4.1.6"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-encrypted-storage"
        ]
      }
    }
  }
